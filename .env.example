APP_NAME=StudyLoop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL (Compose service "mysql"). Use 127.0.0.1 when running PHP on the host.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=studyloop
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis (Compose service "redis"): cache, sessions and Horizon queues.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (Compose service "mailpit"). Web UI on http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@studyloop.test"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# StudyLoop
STUDYLOOP_INVITATION_TTL_DAYS=7
STUDYLOOP_MATERIALS_DISK=local
STUDYLOOP_MATERIALS_MAX_UPLOAD_KB=10240
STUDYLOOP_MATERIALS_MAX_TEXT_CHARACTERS=500000
STUDYLOOP_MATERIALS_MAX_PDF_PAGES=300
STUDYLOOP_MATERIALS_MAX_SECTION_CHARACTERS=6000
# Password for the seeded demo accounts; leave empty to have the seeder generate and print one.
DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Compose port mappings
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Sail runtime user mapping (run `id -u` / `id -g` on the host)
WWWUSER=1000
WWWGROUP=1000
