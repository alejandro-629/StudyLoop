{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "studyloop/scheduler",
    "description": "Framework-free spaced-repetition scheduling for StudyLoop: grades, study days and (soon) SM-2.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "StudyLoop\\Scheduler\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
